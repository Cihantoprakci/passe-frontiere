{% extends 'base.html.twig' %}

{% block title %}Connexion | Passe-Frontière{% endblock %}

{% block body %}
    <div class="container page narrow">
        <div class="stack">
            <h1>Connexion</h1>
            <p class="muted">Retrouvez votre trajet et vos alertes.</p>
        </div>

        {% if error %}
            <p class="flash flash--error">Adresse e-mail ou mot de passe incorrect.</p>
        {% endif %}

        <form class="form" method="post" action="{{ path('app_login') }}">
            <div>
                <label for="email">Adresse e-mail</label>
                <input type="email" id="email" name="email" value="{{ last_email }}" autocomplete="email" required autofocus>
            </div>
            <div>
                <label for="password">Mot de passe</label>
                <input type="password" id="password" name="password" autocomplete="current-password" required>
            </div>
            <div class="checkbox">
                <input type="checkbox" id="remember_me" name="_remember_me">
                <label for="remember_me">Rester connecté sur cet appareil</label>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <div>
                <button class="button" type="submit">Se connecter</button>
            </div>
        </form>

        <p>Pas encore de compte&nbsp;? <a href="{{ path('app_register') }}">Créer un compte</a></p>
    </div>
{% endblock %}
