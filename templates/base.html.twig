<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Passe-Frontière{% endblock %}</title>
        <meta name="description" content="{% block description %}Train ou voiture pour aller à Genève ? Le retard aux douanes du Genevois et les prochains Léman Express, en un coup d'œil.{% endblock %}">
        {% block javascripts %}
            {{ importmap('app') }}
        {% endblock %}
    </head>
    <body>
        <a class="skip-link" href="#contenu">Aller au contenu</a>
        {{ include('partials/_header.html.twig') }}
        <main id="contenu">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="container">
                        <p class="flash {{ type == 'error' ? 'flash--error' }}" role="status">{{ message }}</p>
                    </div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
        {{ include('partials/_footer.html.twig') }}
    </body>
</html>
